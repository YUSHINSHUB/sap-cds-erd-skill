@Metadata.layer: #CORE
annotate entity ZDEMO_C_ORDER with
{
  @UI.facet: [
    {
      id: 'Header',
      type: #IDENTIFICATION_REFERENCE,
      label: '주문',
      position: 10
    },
    {
      id: 'Items',
      type: #LINEITEM_REFERENCE,
      label: '품목',
      position: 20,
      targetElement: '_Item'
    }
  ]
  @UI.lineItem: [{ position: 10 }]
  OrderId;

  @UI.lineItem: [{ position: 20, label: '총금액' }]
  TotalAmount;
}
