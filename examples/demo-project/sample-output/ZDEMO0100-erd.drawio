        <mxCell id="legend" value="&lt;b&gt;범례&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style='background-color:#dae8fc;border:1px solid #6c8ebf'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; R: Root/BO&amp;nbsp;&amp;nbsp;&lt;span style='background-color:#d5e8d4;border:1px solid #82b366'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; I: Interface&amp;nbsp;&amp;nbsp;&lt;span style='background-color:#fff2cc;border:1px solid #d6b656'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; C: Consumption&amp;nbsp;&amp;nbsp;&lt;span style='background-color:#e1d5e7;border:1px solid #9673a6'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; P: Projection&amp;nbsp;&amp;nbsp;&lt;span style='background-color:#f5f5f5;border:1px dashed #666666'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; 패키지 외부 view&amp;nbsp;&amp;nbsp;&lt;span style='background-color:#e6edf5;border:1px solid #5b7896'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; SAP 표준 view&amp;nbsp;&amp;nbsp;&lt;span style='background-color:#ffe6cc;border:1px solid #d79b00'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; DB table&amp;nbsp;&amp;nbsp;&lt;b&gt;굵은 테두리&lt;/b&gt; = 최종 출력 엔터티&amp;nbsp;&amp;nbsp;&lt;b style='color:#7030a0'&gt;Σ 집계&lt;/b&gt; = 집계 함수 · GROUP BY · 집계 대상 조건&lt;br&gt;&lt;span style='color:#7f7f7f'&gt;┄┄▷ 회색 점선&lt;/span&gt;: select from (화살표가 데이터 소스를 가리킴)&amp;nbsp;&amp;nbsp;&lt;span style='color:#9673a6'&gt;┄┄▷ 보라 점선&lt;/span&gt;: projection on&amp;nbsp;&amp;nbsp;&lt;span style='color:#b85450'&gt;┈┈ 붉은 점선&lt;/span&gt;: join&amp;nbsp;&amp;nbsp;&lt;span style='color:#1f4e79'&gt;━━ 파란 실선&lt;/span&gt;: association (끝 모양 = 대상 쪽 카디널리티, 라벨 = 별칭)&amp;nbsp;&amp;nbsp;&lt;span style='color:#1f4e79'&gt;◆━ 파란 실선&lt;/span&gt;: composition (◆ = 부모)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#cccccc;fillColor=#ffffff;spacingLeft=10;fontSize=11;rounded=1;" vertex="1" parent="ent">
